# Database — get connection string from Neon dashboard
DATABASE_URL=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Better Auth base URL — use localhost for dev, Railway URL for prod
BETTER_AUTH_URL=http://localhost:3000

# Public app URL (must match BETTER_AUTH_URL for client-side use)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — add AFTER completing Plan 03 GCP setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AES-256-GCM key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Apple Developer Team ID — required for iOS Universal Links AASA (NATIVE-03)
APPLE_TEAM_ID=

# Android release keystore SHA-256 fingerprint — required for Android App Links assetlinks.json (NATIVE-03)
# Generate with: keytool -list -v -keystore release.keystore -alias <alias>
# Format: AA:BB:CC:... (colon-separated uppercase hex)
ANDROID_CERT_FINGERPRINT=
